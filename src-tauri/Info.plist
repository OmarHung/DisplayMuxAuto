<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <!-- A status bar app: no Dock icon, nothing in Command-Tab. Declared here
         rather than set at runtime so it holds from launch, with no Dock icon
         appearing and then vanishing. Only applies to the built .app — a dev
         build runs unbundled and still shows in the Dock. -->
    <key>LSUIElement</key>
    <true/>
    <key>NSLocalNetworkUsageDescription</key>
    <string>DisplayMuxAuto uses the local network to find and connect to your other computer.</string>
    <key>NSBonjourServices</key>
    <array>
      <string>_displaymux._tcp</string>
    </array>
  </dict>
</plist>
