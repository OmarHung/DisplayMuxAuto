<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <!-- A status bar app that joins the Dock and Command-Tab only while its
         window is open (show_in_dock in lib.rs). Declared here so the process
         starts with no Dock icon, and one appears only once there is a window
         to switch to. Only applies to the built .app — a dev build runs
         unbundled. -->
    <key>LSUIElement</key>
    <true/>
    <key>NSLocalNetworkUsageDescription</key>
    <string>MuxSU uses the local network to find and connect to your other computer.</string>
    <key>NSBonjourServices</key>
    <array>
      <string>_muxsu._tcp</string>
    </array>
  </dict>
</plist>
