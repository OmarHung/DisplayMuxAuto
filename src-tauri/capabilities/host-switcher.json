{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "host-switcher",
  "description": "Minimal permissions for the MuxSU host switcher",
  "windows": ["host-switcher"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-get-host-switcher-state",
    "allow-hide-host-switcher",
    "allow-set-locale",
    "allow-switch-host"
  ]
}
