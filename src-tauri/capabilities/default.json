{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the DisplayMux main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://github.com/OmarHung/DisplayMuxAuto" },
        { "url": "https://github.com/OmarHung/DisplayMuxAuto/**" },
        { "url": "https://github.com/HenryHsu/DisplayMux" },
        { "url": "https://github.com/HenryHsu/DisplayMux/**" }
      ]
    }
  ]
}
